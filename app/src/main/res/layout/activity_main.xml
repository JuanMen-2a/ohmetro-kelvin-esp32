<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo_crema"
        android:padding="24dp">

    <!-- Logo -->
    <ImageView
            android:id="@+id/logo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/logotipo_uis"
            android:contentDescription="@string/desc_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <!-- Icono de ajustes -->
    <ImageView
            android:id="@+id/settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/desc_ajustes"
            app:tint="@color/verde_kelvin"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Círculo del medidor -->
    <FrameLayout
            android:id="@+id/circleContainer"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/circle_green"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp">

        <TextView
                android:id="@+id/valueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/valor_medicion"
                android:textSize="64sp"
                android:textColor="@color/verde_kelvin"
                android:textStyle="bold" />
    </FrameLayout>

    <TextView
            android:id="@+id/unitText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unidad_mohm"
            android:textSize="28sp"
            android:textColor="@color/verde_kelvin"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/circleContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

    <!-- Tarjeta de batería -->
    <LinearLayout
            android:id="@+id/batteryCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_border"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/unitText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <ImageView
                    android:id="@+id/batteryIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_battery"
                    android:contentDescription="@string/desc_bateria"
                    app:tint="@color/verde_kelvin"
                    android:layout_marginEnd="8dp" />

            <TextView
                    android:id="@+id/batteryPercentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="22sp"
                    android:textColor="@color/verde_kelvin"
                    android:textStyle="bold" />

        </LinearLayout>

        <TextView
                android:id="@+id/batteryStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_bateria"
                android:textSize="16sp"
                android:textColor="@color/verde_kelvin"
                android:layout_marginTop="8dp" />

        <TextView
                android:id="@+id/chargeTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tiempo_carga"
                android:textSize="16sp"
                android:textColor="@color/verde_kelvin" />

    </LinearLayout>

    <Button
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/iniciar_medicion"
            android:backgroundTint="@color/verde_kelvin"
            android:textColor="@color/blanco"
            app:layout_constraintTop_toBottomOf="@id/batteryCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>