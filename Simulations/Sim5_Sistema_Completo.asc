TEXT -160 -560 Left 3 ;SIM 5 - SISTEMA COMPLETO: fuente de corriente -> R_TEST (Kelvin) -> INA333 -> ADS1252 -> XIAO ESP32-S3
TEXT -160 -512 Left 2 ;Valores de la PCB: R4 = 10, R3 = 5k, R5 = 6.65k (G = 16.04). Cables Kelvin de 50 mohm cada uno. V(RMED) = resistencia medida (1 V = 1 ohm)
TEXT 1000 -160 Left 2 ;J2: conector Kelvin I+ S+ S- I- y cables de prueba (4 x 50 mohm)
TEXT -160 1100 Left 2 !.include modelos_miliohmimetro.lib
TEXT -160 1132 Left 2 !.param Vbat=3.7 Rt=1
TEXT -160 1164 Left 2 !.step param Rt list 0.005 0.05 0.25 0.5 1
TEXT -160 1196 Left 2 !.tran 0 2.5m 0 20n
TEXT -160 1228 Left 2 !.save V(VCC) V(VREF) V(VSET) V(V_AMP) V(v_volt) V(v_base) V(I_P) V(I_N) V(RMED) V(CODIGO) V(clk) V(sclk) V(adc_out) V(D0) V(3V3) I(R_TEST) I(R4) I(LED5)
TEXT -160 1260 Left 2 !.meas TRAN R_medida FIND V(RMED) AT=2.45m
TEXT -160 1292 Left 2 !.meas TRAN I_dut AVG I(R_TEST) FROM 2m TO 2.4m
TEXT -160 1340 Left 2 ;R_medida (en el Error Log, Ctrl+L) debe coincidir con Rt. La entrada VREF (2.5V) del ADS1252 es la misma VREF del TL431.
